PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bookmyshow
JWT_SECRET=change_this_to_any_long_random_text

# The account that registers/logs in with this email becomes admin
ADMIN_EMAIL=youremail@example.com

# Razorpay TEST keys (leave empty to use demo payment)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (leave SMTP_HOST empty to skip emails). Gmail example:
# SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com  SMTP_PASS=<gmail app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
